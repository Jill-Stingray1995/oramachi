# Production Apache/Xserver settings for https://oramachi-jp.com/
#
# Deploy this file as ".htaccess" together with the contents produced in dist/.
# The legacy extensionless "htaccess" file is intentionally not a release asset.

DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Keep a single canonical production host, including for Host values with an
  # unexpected port.
  RewriteCond %{HTTP_HOST} !^oramachi-jp\.com$ [NC]
  RewriteRule ^ https://oramachi-jp.com%{REQUEST_URI} [R=301,L,NE]

  # Xserver's official configuration checks HTTPS directly. Do not trust a
  # client-supplied X-Forwarded-Proto header here.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://oramachi-jp.com%{REQUEST_URI} [R=301,L,NE]

  # Defense in depth in case somebody uploads the repository root instead of
  # the generated dist/ directory.
  RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L,NC]
  RewriteRule ^(?:\.git|\.github|gas|research|rollback|staging|tools)(?:/|$) - [F,L,NC]
  RewriteRule ^(?:editor\.html|bump-version\.js|htaccess|CNAME|.*\.(?:md|bak|conf|env|ini|log|orig|sql|swp|tmp|ya?ml))$ - [F,L,NC]
</IfModule>

<IfModule mod_headers.c>
  # Add includeSubDomains/preload only after every subdomain has been inventoried
  # and confirmed to support HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set X-XSS-Protection "0"

  # The application intentionally uses inline handlers, Google Analytics,
  # AdSense, Google Fonts, Google Maps embeds, and a Google Apps Script API.
  # HTTPS is therefore allowed for those third-party resource classes while
  # object embedding, base-tag injection, and framing of this site are blocked.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https:; frame-src https:; worker-src 'self' blob:; manifest-src 'self'; media-src 'self' https:; upgrade-insecure-requests"

  # HTML must be revalidated so that cache-busting asset versions propagate.
  <FilesMatch "\.html$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>

  # Versioned JS/CSS/data URLs may be cached; revalidation protects unversioned
  # direct requests. The Service Worker and manifest are excluded below because
  # browsers must discover their newest bytes without waiting for this TTL.
  <FilesMatch "^(?!(?:service-worker\.js|manifest\.json)$).*\.(?:css|js|json)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
  <Files "service-worker.js">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
    Header always set Service-Worker-Allowed "/"
  </Files>
  <Files "manifest.json">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </Files>
  <FilesMatch "\.(?:ico|png)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# Keep Xserver's X Accelerator behavior while excluding HTML from its static
# cache. These environment names are documented/generated by Xserver.
SetEnvIf Request_URI ".*" Ngx_Cache_NoCacheMode=off
SetEnvIf Request_URI ".*" Ngx_Cache_StaticMode
SetEnvIf Request_URI "\.html$" Ngx_Cache_NoCacheMode=on
SetEnvIf Request_URI "^/$" Ngx_Cache_NoCacheMode=on
SetEnvIf Request_URI "^/(?:service-worker[.]js|manifest[.]json)(?:[?]|$)" Ngx_Cache_NoCacheMode=on

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/manifest+json
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
</IfModule>
